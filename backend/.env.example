# Copy to .env and adjust for your machine. Never commit .env.

ENVIRONMENT=local
DEBUG=false

# Both the async API session and the sync worker session use psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talkfiesta
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

# Use a strong, environment-specific secret before exposing the API.
JWT_SECRET_KEY=local-development-secret-change-me
REFRESH_COOKIE_SECURE=true

# SMTP: STARTTLS (587) or SSL (465), not both. Keep credentials in .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# Google OAuth web client ID; the backend verifies it as the ID-token audience.
GOOGLE_CLIENT_ID=
