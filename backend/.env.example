# Copy to .env and adjust for your machine. Never commit .env.

ENVIRONMENT=local
DEBUG=false

# Both the async API session and the sync worker session use psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/talkfiesta
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

# Separate broker database from API rate-limit keys. PostgreSQL stores job results.
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_TASK_TIME_LIMIT=300
CELERY_VISIBILITY_TIMEOUT=900
OUTBOX_DISPATCH_ENABLED=false
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_SECONDS=2
OUTBOX_LEASE_SECONDS=120
OUTBOX_MAX_ATTEMPTS=20
ASSESSMENT_EXECUTION_ENABLED=false
ASSESSMENT_JOB_LEASE_SECONDS=360
ASSESSMENT_JOB_MAX_ATTEMPTS=3

# Use a strong, environment-specific secret before exposing the API.
JWT_SECRET_KEY=local-development-secret-change-me
REFRESH_COOKIE_SECURE=true

# SMTP: STARTTLS (587) or SSL (465), not both. Keep credentials in .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# Google OAuth web client ID; the backend verifies it as the ID-token audience.
GOOGLE_CLIENT_ID=

ASSESSMENT_CONTENT_RELEASE=placement-bank-v1
ASSESSMENT_STARTS_PER_DAY=3

# Private S3 bucket; credentials use boto3's standard AWS provider chain.
S3_BUCKET=
S3_REGION=us-east-1
AUDIO_UPLOAD_URL_SECONDS=300
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_DURATION_SECONDS=180
AUDIO_RETENTION_DAYS=7
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
